# Copy this file to .env and replace the placeholder values.

# OpenAI-compatible agent model
LLM_PROVIDER_URL=http://127.0.0.1:18080/v1
LLM_NAME=Qwen/Qwen3.6-27B
LLM_API_KEY=NO_API_KEY
LLM_THINK=False
LLM_CONTEXT_LENGTH=262144
LLM_OUTPUT_LENGTH=20000

# OpenAI-compatible judge model (required by `agent_chain.py eval`)
JUDGE_LLM_PROVIDER_URL=http://127.0.0.1:18080/v1
JUDGE_LLM_NAME=Qwen/Qwen3.6-27B
JUDGE_API_KEY=NO_API_KEY
JUDGE_CONTEXT_LENGTH=262144
JUDGE_OUTPUT_LENGTH=20000

# MongoDB used by dataset extraction and chain agent tasks/results
MONGO_URL=localhost:27017
MONGO_USER=
MONGO_PASSWD=
MONGO_DB=onchain_case_qa_dataset
MONGO_AUTH_SOURCE=admin

# External services. Install and start them separately.
ETH_INDEX_URL=http://127.0.0.1:8000
BROWSER_BASE=http://127.0.0.1:5010

# Optional chain-QA/index tuning
CHAIN_QA_CONNECT_TIMEOUT=5
CHAIN_QA_TIMEOUT=60
CHAIN_QA_REQUEST_RETRIES=1
CHAIN_QA_RETRY_BACKOFF=1.0
CHAIN_QA_TRANSACTION_QUERY_LIMIT=100000

# Optional chain-agent context/tool limits
CHAIN_MAX_TOOL_ITERATIONS=4
CHAIN_MAX_TOOL_COLLECTION_TURNS=64
CHAIN_TOOL_RESULT_CHAR_LIMIT=4000
CHAIN_CONTEXT_CHAR_LIMIT=60000
CHAIN_DETECTOR_TOOL_RESULT_CHAR_LIMIT=60000
